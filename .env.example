# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=
# Where new leads are emailed, e.g. info@landlords.co.il
LEAD_EMAIL_TO=
# Optional: sender on a domain verified in Resend, e.g. "Landlord <site@landlords.co.il>"
# If empty, Resend's test sender onboarding@resend.dev is used (only delivers to your Resend account email).
RESEND_FROM=
