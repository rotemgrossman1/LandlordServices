{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "landlord-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "landlord-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "landlord-drafts",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "SHOW_DRAFTS=1",
        "npx",
        "next",
        "dev",
        "-p",
        "3200"
      ],
      "port": 3200
    }
  ]
}
